# Dengar.in — Backend Environment Variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# TIER 1 — Primary AI model, called directly against the DeepSeek Platform
# (api.deepseek.com) — NOT through OpenRouter (services/orchestrator).
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional: override the model slug (default: deepseek-v4.1-flash). DeepSeek
# occasionally renames/retires model slugs — check
# https://api-docs.deepseek.com/quick_start/pricing if requests start 404ing.
DEEPSEEK_MODEL=

# TIER 2 — Secondary cloud fallback / "second brain" via OpenRouter
# (services/orchestrator). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model slug (default: a free ":free" model —
# meta-llama/llama-3.3-70b-instruct:free). OpenRouter's free-tier catalog
# and rate limits rotate over time — pick a current one from
# https://openrouter.ai/models?max_price=0 if the default stops working.
OPENROUTER_MODEL=
# Optional, free-tier attribution only (never required for requests to work)
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# PostgreSQL connection string for services/persistence adapters (forum
# moderation queue, encrypted cross-device sync, admin accounts). When unset,
# the app transparently falls back to in-memory storage for local dev
# (see services/persistence/src/factory.ts).
#
# Supabase Connection String (Transaction Pooler - Port 6543, recommended for Next.js):
#   Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase Direct Connection (Port 5432):
#   Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Run once after DATABASE_URL is set: `npm run db:migrate`

# Secret used to sign the admin/moderator session cookie (services/auth,
# apps/web/src/lib/api/adminSession.ts). Required for /api/admin/login to
# work. Generate one with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# One-time seed values for `npm run db:seed-admin`
# (services/persistence/scripts/seedAdmin.ts). Not read at request time —
# only needed when running the seed script.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
