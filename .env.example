# Dengar.in — Backend Environment Variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# TIER 1 — Primary AI model (services/orchestrator)
DEEPSEEK_API_KEY=

# TIER 2 — Secondary cloud fallback (services/orchestrator)
OPENROUTER_API_KEY=

# PostgreSQL connection string for services/persistence adapters (forum
# moderation queue, encrypted cross-device sync, admin accounts). When unset,
# the app transparently falls back to in-memory storage for local dev
# (see services/persistence/src/factory.ts).
#   Example: postgresql://user:password@localhost:5432/dengarin
DATABASE_URL=

# Run once after DATABASE_URL is set: `npm run db:migrate`

# Secret used to sign the admin/moderator session cookie (services/auth,
# apps/web/src/lib/api/adminSession.ts). Required for /api/admin/login to
# work. Generate one with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# One-time seed values for `npm run db:seed-admin`
# (services/persistence/scripts/seedAdmin.ts). Not read at request time —
# only needed when running the seed script.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
