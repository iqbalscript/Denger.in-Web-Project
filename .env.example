# Dengar.in — Backend Environment Variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# TIER 1 — Primary AI model, called directly against the DeepSeek Platform
# (api.deepseek.com) — NOT through OpenRouter (services/orchestrator).
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional: override the model slug (default: deepseek-flash). DeepSeek
# occasionally renames/retires model slugs — check
# https://api-docs.deepseek.com/quick_start/pricing if requests start 404ing.
DEEPSEEK_MODEL=

# TIER 2 — Secondary cloud fallback / "second brain" via OpenRouter
# (services/orchestrator). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model slug (default: a free ":free" model —
# meta-llama/llama-3.3-70b-instruct:free). OpenRouter's free-tier catalog
# and rate limits rotate over time — pick a current one from
# https://openrouter.ai/models?max_price=0 if the default stops working.
OPENROUTER_MODEL=
# Optional, free-tier attribution only (never required for requests to work)
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# TIER 3 — Tertiary generative fallback (services/orchestrator, Google Gemini)
# and the optional Ruang Ngobrol TTS (apps/web/src/lib/api/geminiTts.ts).
# Get a key at https://aistudio.google.com/apikey. Leave empty to skip the tier.
GEMINI_API_KEY=
# Optional: override the model slug (default: gemini-3.1-flash-lite).
GEMINI_MODEL=

# Optional: point DeepSeek calls at a compatible proxy/base URL instead of
# https://api.deepseek.com/v1/chat/completions (services/orchestrator).
DEEPSEEK_BASE_URL=
# Legacy alias of DEEPSEEK_BASE_URL, read only when DEEPSEEK_BASE_URL is unset.
# DEEPSEEK_API_URL=

# PostgreSQL connection string for services/persistence adapters (forum
# moderation queue, encrypted cross-device sync, admin accounts). When unset,
# the app transparently falls back to in-memory storage for local dev
# (see services/persistence/src/factory.ts).
#
# Supabase Connection String (Transaction Pooler - Port 6543, recommended for Next.js):
#   Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase Direct Connection (Port 5432):
#   Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
# Optional, pick AT MOST ONE: custom CA for verifying the database's TLS
# certificate (services/persistence/src/db/pool.ts). Supabase hosts already
# get their root CA built in; localhost never uses TLS.
#   DATABASE_CA_FILE = path to a PEM file on the server
#   DATABASE_CA_CERT = the PEM contents inline
DATABASE_CA_FILE=
DATABASE_CA_CERT=

# Redis — cache ISR/SSG bersama (apps/web/cache-handler.mjs), kuota rate limit
# terdistribusi (apps/web/src/lib/api/rateLimit.ts), dan cache respons AI
# (apps/web/src/lib/api/aiCache.ts). Lihat docs/REDIS.md.
#
# Biarkan KOSONG untuk menonaktifkan Redis sepenuhnya — aplikasi otomatis
# jatuh ke penghitung in-memory dan cache LRU lokal, tanpa error.
#
# Lokal (Docker):  docker run -d -p 6379:6379 redis:7-alpine
#   REDIS_URL=redis://localhost:6379
# Terkelola (wajib TLS, perhatikan skema rediss://):
#   REDIS_URL=rediss://default:[PASSWORD]@[HOST]:[PORT]
REDIS_URL=

# Kuota per-klien untuk rate limit (apps/web/src/lib/api/rateLimit.ts).
# OPSIONAL dan mati secara bawaan: tanpa keduanya, semua klien anonim berbagi
# satu kuota per rute (perilaku M01). Isi KEDUANYA hanya bila aplikasi berada di
# belakang proxy/CDN tepercaya yang menimpa header X-Forwarded-For dan origin
# tidak bisa diakses langsung. Lihat docs/M01_RATE_LIMITING.md.
#   TRUSTED_PROXY_HOPS = jumlah proxy tepercaya di depan aplikasi (1-5).
#   RATE_LIMIT_HASH_SECRET = kunci HMAC (min. 16 karakter) untuk menyamarkan IP.
#     Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRUSTED_PROXY_HOPS=
RATE_LIMIT_HASH_SECRET=

# Run once after DATABASE_URL is set: `npm run db:migrate`

# Secret used to sign the admin/moderator session cookie (services/auth,
# apps/web/src/lib/api/adminSession.ts). Required for /api/admin/login to
# work. Generate one with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# Required for stable, server-generated aliases within one forum story. Use a
# distinct high-entropy secret; thread capabilities are scoped by story before
# HMAC and are never stored server-side in raw form.
# Bila dikosongkan tetapi ADMIN_SESSION_SECRET terisi (mis. slot env di hosting
# penuh), secret diturunkan satu arah dari ADMIN_SESSION_SECRET.
FORUM_THREAD_ALIAS_SECRET=

# One-time seed values for `npm run db:seed-admin`
# (services/persistence/scripts/seedAdmin.ts). Not read at request time —
# only needed when running the seed script.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# AMD Developer Cloud — model Care Passport (Track 2, AMD-07).
# Nilai berasal dari endpoint vLLM milik tim di AMD Developer Cloud (Instinct/ROCm);
# JANGAN pernah commit key asli. Lihat services/orchestrator/src/providers/amdProvider.ts.
#   AMD_BASE_URL = root OpenAI-compatible, mis. lewat SSH tunnel:
#                  http://127.0.0.1:8000/v1 (dengan/tanpa /v1 sama-sama diterima)
#   AMD_API_KEY  = nilai --api-key vLLM. Boleh kosong hanya jika endpoint loopback-only.
#   AMD_MODEL    = id model persis seperti di GET /v1/models.
#   AMD_JSON_MODE= isi `true` HANYA jika probeAmdEndpoint() melaporkan jsonModeOk: true.
AMD_BASE_URL=
AMD_API_KEY=
AMD_MODEL=
AMD_JSON_MODE=
AMD_TIMEOUT_MS=12000

# Cache balasan AI /api/chat di Redis bersama (audit H6). BAWAAN MATI.
# Balasan AI lazim mengutip isi curhat, jadi jangan diaktifkan di produksi
# tanpa keputusan privasi tertulis. Isi `true` hanya untuk demo/uji beban.
# Kalaupun aktif: TTL 10 menit, tidak pernah untuk noStore (Ruang Ngobrol)
# atau giliran high distress. Lihat apps/web/src/lib/api/aiCache.ts.
AI_RESPONSE_CACHE=

# Matikan pass "Second Brain" debiaser (panggilan LLM kedua) dengan `off`
# (audit M10). Bawaan: aktif bila OPENROUTER_API_KEY terisi, tetapi selalu
# dalam anggaran waktu per giliran chat (18 dtk) dan dilewati bila panggilan
# utama sudah memakai sebagian besar anggaran itu.
DENGARIN_DEBIASER=
