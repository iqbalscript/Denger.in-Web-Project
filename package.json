{
  "name": "dengarin-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Dengar.in — Pendamping Mental Well-being Anonim Berbasis AI",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "test:crisis": "node --experimental-strip-types tests/crisis/crisisEngine.test.mjs && node --experimental-strip-types tests/crisis/crisisRegression.test.mjs",
    "test:validator": "node --experimental-strip-types tests/validator/actionValidator.test.mjs && node --experimental-strip-types tests/validator/contentModerator.test.mjs",
    "test:assessment": "node --experimental-strip-types tests/assessment/adaptiveAssessment.test.mjs",
    "test:orchestrator": "node --experimental-strip-types tests/orchestrator/orchestrator.test.mjs",
    "test:persistence": "node --experimental-strip-types tests/persistence/forumRepository.test.mjs",
    "test:auth": "node --experimental-strip-types tests/auth/auth.test.mjs",
    "test:crypto": "node --experimental-strip-types tests/crypto/e2ee.test.mjs && node --experimental-strip-types tests/crypto/recoverySecurity.test.mjs",
    "test:persistence-pg": "node --experimental-strip-types tests/persistence-pg/tlsSecurity.test.mjs && node --experimental-strip-types tests/persistence-pg/postgresRepositories.test.mjs",
    "test": "npm run test:crisis && npm run test:validator && npm run test:assessment && npm run test:orchestrator && npm run test:persistence && npm run test:auth && npm run test:crypto && npm run test:persistence-pg",
    "db:migrate": "npm run db:migrate --workspace=services/persistence",
    "db:seed-admin": "npm run db:seed-admin --workspace=services/persistence",
    "supabase:migration:list": "npx supabase migration list",
    "supabase:db:push:dry": "npx supabase db push --dry-run",
    "supabase:db:push": "npx supabase db push"
  },
  "keywords": [
    "mental-health",
    "well-being",
    "anonymous",
    "ai-orchestrator",
    "crisis-safety"
  ],
  "author": "Dengar.in Team",
  "license": "MIT"
}
